  <!-- Parameter settings -->
  <string name="param_temp_hint">Please enter a value between 0 and 2.0</string>
  <string name="param_temp_desc">Controls the randomness of the model output. A value of 0 yields near-deterministic results; higher values produce more creative and diverse outputs</string>
  <string name="param_topp_hint">Please enter a value between 0.0 and 1.0</string>
  <string name="param_topp_desc">Also known as nucleus sampling. The model samples from the smallest set of tokens whose cumulative probability reaches top_p. Generally, adjust only temperature or top_p, not both</string>
  <string name="param_freq_hint">Please enter a value between -2.0 and 2.0</string>
  <string name="param_freq_desc">Penalizes tokens based on their frequency in the generated text. Positive values reduce repetition</string>
  <string name="param_rep_hint">Please enter a value between -2.0 and 2.0</string>
  <string name="param_rep_desc">Penalizes tokens based on whether they have already appeared, regardless of frequency. Positive values encourage the model to introduce new topics</string>

